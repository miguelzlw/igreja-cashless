# Firebase Web SDK (use os valores do seu projeto Firebase: Console → Configurações → Geral)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Região das Cloud Functions
NEXT_PUBLIC_FIREBASE_REGION=southamerica-east1

# ─────────────────────────────────────────────────────────────────
# PIX (Asaas) — server-side apenas, SEM o prefixo NEXT_PUBLIC
# ─────────────────────────────────────────────────────────────────

# API key do Asaas — pegar em https://www.asaas.com → Integrações → API
# Use a key de SANDBOX em desenvolvimento e a de PRODUÇÃO no evento.
ASAAS_API_KEY=

# Token que o Asaas vai mandar de volta no header `asaas-access-token`
# nos webhooks. Você define esse valor (ex: uma string aleatória de 32+ chars)
# e configura no painel do Asaas → Integrações → Webhooks → Token de autenticação.
ASAAS_WEBHOOK_TOKEN=

# Segredo compartilhado entre o webhook (Next.js) e a Cloud Function
# `creditPixPayment`. Use uma string aleatória de 32+ chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# O MESMO valor precisa estar configurado também na Cloud Function:
#   firebase functions:secrets:set INTERNAL_WEBHOOK_SECRET
INTERNAL_WEBHOOK_SECRET=

# URL pública da Cloud Function `creditPixPayment` (Firebase mostra após o deploy).
# Formato: https://<region>-<project>.cloudfunctions.net/creditPixPayment
CREDIT_PIX_URL=
